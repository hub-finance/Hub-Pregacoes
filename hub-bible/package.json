{
  "name": "hub-bible",
  "version": "1.0.0",
  "private": true,
  "description": "Hub Bible — Biblia, estudo, devocional e organizador ministerial (PWA)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit false --pretty",
    "bible:build": "node scripts/build-bible-data.mjs",
    "lexicon:build": "node scripts/build-lexicon.mjs",
    "android:sync": "npm run build && rm -f dist/sw.js dist/workbox-*.js dist/registerSW.js && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/share": "^7.0.4",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "docx-preview": "^0.4.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38",
    "pptx-preview": "^1.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
